{
  "name": "nekodemo",
  "version": "0.1.0",
  "private": true,
  "description": "猫がテーマのプロトタイプ用デザインシステム（React / Tailwind v4 / shadcn）。AI コーディングツール向け。",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "shadcn",
    "prototype",
    "cat",
    "ai-coding"
  ],
  "license": "MIT",
  "author": "Ryoga Isozumi",
  "homepage": "https://gp-ryoga-isozumi.github.io/nekodemo-cat-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gp-ryoga-isozumi/nekodemo-cat-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/gp-ryoga-isozumi/nekodemo-cat-design-system/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "nekodemo": "bin/nekodemo.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./themes/registry": {
      "types": "./dist/themes/registry.d.ts",
      "import": "./dist/themes/registry.js"
    },
    "./ai/*": "./dist/ai/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "scripts/check/index.mjs",
    "scripts/check/rules.mjs",
    "icons/status.json",
    "skills",
    "llms.txt",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:themes": "node scripts/build-themes.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "icons:list": "node scripts/icons/list-used-icons.mjs",
    "icons:vectorize": "node scripts/icons/vectorize.mjs",
    "icons:audit": "node scripts/icons/audit.mjs",
    "build:icons": "node scripts/icons/build-icons.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:readmes": "node scripts/build-readmes.mjs",
    "build:package": "tsc -p tsconfig.build.json && node scripts/build-package.mjs",
    "check": "node scripts/check/index.mjs src --strict",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings . && node scripts/lint-imports.mjs",
    "format": "biome format --write .",
    "new-component": "bash scripts/new-component.sh",
    "pack:test": "node scripts/pack-test.mjs",
    "icons:prompts": "node scripts/icons/gen-prompts.mjs",
    "icons:inspect": "node scripts/icons/inspect.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^9.4.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@material-symbols/svg-500": "^0.47.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "^8.20.0",
    "culori": "^4.0.2",
    "jsdom": "^30.1.0",
    "next": "^16.3.5",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "storybook": "^10.6.0",
    "svg-path-bbox": "^2.1.0",
    "svgo": "^4.1.0",
    "svgpath": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
