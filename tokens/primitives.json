  "shadow": {
    "$comment": "影の色はテーマの --nk-p-shadow-tint（毛色に寄せた色）を参照する",
    "raise": "0 1px 2px color-mix(in oklch, var(--nk-p-shadow-tint) 12%, transparent)",
    "float": "0 4px 12px color-mix(in oklch, var(--nk-p-shadow-tint) 16%, transparent), 0 1px 3px color-mix(in oklch, var(--nk-p-shadow-tint) 10%, transparent)",
    "popout": "0 12px 32px color-mix(in oklch, var(--nk-p-shadow-tint) 22%, transparent), 0 2px 6px color-mix(in oklch, var(--nk-p-shadow-tint) 10%, transparent)"
  },
  "typography": {
    "$comment": "12 段階（12〜54px）。行間は 4px グリッドに乗る値【初期案】。ウェイトは 400 / 700 のみ",
    "scale": [
      { "step": 1, "px": 12, "size": "0.75rem", "lineHeight": "1.25rem" },
      { "step": 2, "px": 14, "size": "0.875rem", "lineHeight": "1.5rem" },
      { "step": 3, "px": 16, "size": "1rem", "lineHeight": "1.5rem" },
