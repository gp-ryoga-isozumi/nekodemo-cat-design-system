      { "step": 12, "px": 54, "size": "3.375rem", "lineHeight": "4.5rem" }
    ],
    "aliases": {
      "$comment": "AI の癖に合わせた別名。同じ段階を指す",
      "xs": 1,
      "sm": 2,
      "base": 3,
      "lg": 4,
      "xl": 5,
      "2xl": 6,
      "3xl": 8,
      "4xl": 10
